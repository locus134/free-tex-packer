{
  "name": "free-tex-packer",
  "version": "0.6.11",
  "description": "Free texture packer",
  "homepage": "https://github.com/locus134/free-tex-packer",
  "author": "Alexander Norinchak <norinchak@gmail.com>",
  "main": "main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron . --env development",
    "start-prod": "electron .",
    "build": "electron-builder --publish never",
    "build-mac": "electron-builder --mac --arm64 --x64 --publish never",
    "build-win": "electron-builder --win --x64 --publish never",
    "build-publish": "electron-builder --ia32 --x64 --publish always"
  },
  "build": {
    "files": [
      "main.js",
      "www/**/*"
    ],
    "appId": "com.free.tex.packer",
    "productName": "Free texture packer",
    "artifactName": "FreeTexturePacker-${version}-${arch}.${ext}",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icons/256x256.png"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Graphics",
      "executableName": "FreeTexturePacker",
      "icon": "build/icons/icons.icns"
    },
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": "dmg",
      "icon": "build/icons/icons.icns"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "dist/app"
    },
    "fileAssociations": {
      "ext": "ftpp",
      "name": "Free texture packer project"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "locus134",
        "repo": "free-tex-packer"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/locus134/free-tex-packer.git"
  },
  "keywords": [],
  "license": "ISC",
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "dependencies": {
    "electron-log": "^2.2.17",
    "electron-updater": "6.8.11",
    "electron-window-state": "^5.0.3",
    "optimist": "^0.6.1",
    "tinify": "1.8.3"
  }
}
